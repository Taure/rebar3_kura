{erl_opts, [debug_info]}.

{deps, [{kura, ">= 2.31.1 and < 3.0.0"}]}.

{profiles, [
    {test, [{deps, [{meck, "1.2.0"}, {proper, "1.5.0"}, {erlfmt, "1.8.0"}]}]},
    {eqwalizer, [
        {deps, [
            {eqwalizer_support,
                {git_subdir, "https://github.com/WhatsApp/erlang-language-platform.git",
                    {tag, "2026-10-14"}, "eqwalizer/eqwalizer_support"}}
        ]}
    ]}
]}.

{project_plugins, [
    {covertool, "2.0.7"},
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git",
            {ref, "a2d37609afb43e371e074d3e0b64d3baec67398e"}}},
    {rebar3_audit, "0.2.8"},
    {erlfmt, "1.8.0"},
    {rebar3_hex, "7.5.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [write]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{xref_ignores, [
    {erlfmt, format_string, 2},
    {providers, create, 1},
    {rebar_api, abort, 2},
    {rebar_api, info, 2},
    {rebar_api, warn, 2},
    {rebar_app_info, dir, 1},
    {rebar_app_info, ebin_dir, 1},
    {rebar_app_info, name, 1},
    {rebar_state, add_provider, 2},
    {rebar_state, all_deps, 1},
    {rebar_state, current_app, 1},
    {rebar_state, get, 3},
    {rebar_state, command_parsed_args, 1},
    {rebar_state, project_apps, 1}
]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns]},
    {plt_extra_apps, [kura]},
    {exclude_mods, [
        rebar3_kura,
        rebar3_kura_check,
        rebar3_kura_compile,
        rebar3_kura_setup,
        rebar3_kura_gen_auth,
        rebar3_kura_gen_schemas,
        rebar3_kura_lint_migrations
    ]}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {source_url, <<"https://github.com/Taure/rebar3_kura">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>},
    {homepage_url, <<"https://github.com/Taure/rebar3_kura">>},
    {api_reference, true}
]}.

{cover_enabled, true}.
